# ============================================================
# RSR ErrorSentinel AI — Configuration Environment Template
# ============================================================

# Application
APP_NAME=RSR ErrorSentinel AI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Email Provider: gmail | microsoft_graph | demo | mock
EMAIL_PROVIDER=gmail

# ------------------------------------------------------------
# Gmail Provider (OAuth2 API)
# ------------------------------------------------------------
GMAIL_USER=me
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send

# Dashboard Google sign-in and Gmail connection OAuth (Web application client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact callback URLs registered in Google Cloud Console; configure separately per environment.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/gmail/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Generate stable values; never commit populated values.
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET_KEY=
GMAIL_MAX_CONNECTIONS=10

# ------------------------------------------------------------
# Microsoft Graph Provider (Future Enterprise MS365)
# ------------------------------------------------------------
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MONITOR_MAILBOX=
ALERT_FROM_MAILBOX=
ALERT_RECIPIENTS=ops@rsr.internal,alerts@rsr.internal

# ------------------------------------------------------------
# AI / LLM Configuration: mock | openai | gemini | anthropic | ollama | none
# ------------------------------------------------------------
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
MAX_LLM_CONCURRENCY=3
MAX_LLM_INPUT_CHARS=50000

# ------------------------------------------------------------
# Concurrency & Worker Limits
# ------------------------------------------------------------
MAX_EMAIL_WORKERS=5
MAX_ATTACHMENT_WORKERS=5
MAX_ATTACHMENT_SIZE_MB=25
MONITOR_INTERVAL_MINUTES=30
SCHEDULE_MINUTES=30
ENABLE_EMAIL_ATTACHMENTS=true

# ------------------------------------------------------------
# Database & Storage
# ------------------------------------------------------------
DATABASE_URL=sqlite:///./data/app.db
ENABLE_DASHBOARD=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
