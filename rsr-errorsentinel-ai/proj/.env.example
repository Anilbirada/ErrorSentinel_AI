APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# gmail (stage 4) | microsoft_graph (future) | memory (demo/tests only)
EMAIL_PROVIDER=gmail
GMAIL_USER=
GMAIL_CREDENTIALS_FILE=
GMAIL_TOKEN_FILE=

# LLM is optional. Leave LLM_PROVIDER empty for regex-only extraction.
# Supported: anthropic (untested adapter), mock
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

MONITOR_INTERVAL_MINUTES=30
MAX_EMAIL_WORKERS=5
MAX_ATTACHMENT_WORKERS=5
MAX_LLM_CONCURRENCY=3
MAX_ATTACHMENT_SIZE_MB=25

DATABASE_URL=sqlite:///data/app.db
REPORT_OUTPUT_DIR=reports
LOG_DIR=logs
REGISTRY_FILE=data/existing_error_codes.txt
# Optional JSON file with extra regex rules (see README)
PATTERNS_FILE=
# Comma-separated list of people who receive alerts
ALERT_RECIPIENTS=
